{
  "name": "plainfile",
  "version": "0.14.0",
  "private": true,
  "description": "A productivity hub over a plain folder of markdown files.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "plainfile": "tsx src/cli.ts",
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "test:e2e": "playwright test --trace off"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.6",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
