{
  "name": "plainfile",
  "version": "1.6.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adambeltz2/Plainfile.git"
  },
  "homepage": "https://adambeltz2.github.io/Plainfile/",
  "private": true,
  "description": "A productivity hub over a plain folder of markdown files.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "plainfile": "tsx src/cli.ts",
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "test:e2e": "playwright test --trace off",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "coverage": "vitest run --coverage --coverage.include=src --coverage.reporter=text-summary --coverage.reporter=text --coverage.reportsDirectory=coverage"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "esbuild": "0.28.2",
    "prettier": "3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
